# Express backend
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
AI_LAYER_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_MS=180000

# Optional browser/client bearer token.
# Leave empty for local frontend development.
# For protected API clients, set a long random value and send:
# Authorization: Bearer <token>
API_BEARER_TOKEN=

# Required for protecting Express -> FastAPI traffic.
# Set the SAME long random value in ai_layer/.env.
INTERNAL_API_KEY=replace-with-a-long-random-secret
