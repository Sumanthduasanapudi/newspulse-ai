# Anthropic / LangChain
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5

# Must match backend_layer/.env INTERNAL_API_KEY.
# When set, FastAPI AI endpoints reject requests without x-internal-key.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=newspulse-ai
